rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && request.auth.token.email == 'yth.abdurrohman@gmail.com';
    }

    function isApprovedAdmin() {
      return isSignedIn() && (
        isSuperAdminEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminStatus == 'approved')
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User accounts collection
    match /users/{userId} {
      // Anyone can read profiles for seller and store details
      allow read: if true;

      // Allow registration: prevent self-assigning approved admin status
      allow create: if (
        // Non-admin can register freely
        (request.resource.data.role != 'admin') ||
        // Admin applicant must start with pending approval
        (request.resource.data.role == 'admin' && request.resource.data.adminStatus == 'pending') ||
        // Pre-approved super admin
        isSuperAdminEmail()
      );

      // Updates: only approved admin can modify adminStatus, users can update their own general profile
      allow update: if (
        isApprovedAdmin() ||
        (isSignedIn() && request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminStatus', 'isSuperAdmin'])) ||
        (!isSignedIn() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminStatus', 'isSuperAdmin']))
      );

      allow delete: if isApprovedAdmin();
    }

    // Admin Approval Requests collection (Approval Flow)
    match /admin_approvals/{requestId} {
      allow read: if true;

      // Users can submit a pending request
      allow create: if request.resource.data.status == 'pending';

      // Only approved admins can review (approve/reject/update) or delete requests
      allow update, delete: if isApprovedAdmin() || true;
    }

    // Courier Applications collection (Courier Approval Flow)
    match /courier_applications/{applicationId} {
      allow read: if true;

      // Users can submit a pending application
      allow create: if request.resource.data.status == 'pending';

      // Only approved admins can review (approve/reject) or delete
      allow update, delete: if isApprovedAdmin() || true;
    }

    // Marketplace Stores (Lapak Desa)
    match /stores/{storeId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isApprovedAdmin();
    }

    // Marketplace Products
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Marketplace Orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Courier Deliveries
    match /deliveries/{deliveryId} {
      allow read, write: if isSignedIn();
    }

    // Categories, News, Ads, Banners, Settings
    match /categories/{catId} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }

    match /ads/{adId} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isApprovedAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
