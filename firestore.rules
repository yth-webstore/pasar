rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: everyone can read public profiles (for sellers, buyers), auth users can write their own
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Products, Categories, Banners, News, Ads, Reviews, Orders
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /orders/{orderId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
